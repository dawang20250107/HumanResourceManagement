# ── Database ────────────────────────────────────────────────
# Used by apps/api (Prisma). Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://flexforce:flexforce@localhost:5432/flexforce?schema=public"

# ── API ─────────────────────────────────────────────────────
API_PORT=4000
# Comma-separated list of allowed CORS origins for the web app.
CORS_ORIGIN="http://localhost:3000"

# ── Web ─────────────────────────────────────────────────────
# Base URL the Next.js app uses to reach the NestJS API.
NEXT_PUBLIC_API_URL="http://localhost:4000"
